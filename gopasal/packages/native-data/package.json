{
  "name": "@gopasal/native-data",
  "version": "0.1.0",
  "private": true,
  "description": "GoPasal native data layer — transport, session, offline cache and the write outbox shared by the customer, seller and rider apps.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./seller": "./src/seller.ts",
    "./seller-catalog": "./src/seller-catalog.ts",
    "./seller-delivery": "./src/seller-delivery.ts",
    "./seller-onboarding": "./src/seller-onboarding.ts",
    "./seller-promotions": "./src/seller-promotions.ts",
    "./seller-settings": "./src/seller-settings.ts",
    "./seller-team": "./src/seller-team.ts",
    "./rider": "./src/rider.ts"
  },
  "scripts": {
    "lint": "echo \"(native-data) linted by the consuming apps\" && exit 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@gopasal/api-client": "workspace:*",
    "socket.io-client": "^4.8.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@tanstack/react-query": "*",
    "expo-constants": "*",
    "expo-secure-store": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5",
    "@tanstack/react-query": "^5",
    "@tanstack/react-query-persist-client": "^5",
    "@types/react": "~19.2.2",
    "expo-constants": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "5.9.3"
  }
}

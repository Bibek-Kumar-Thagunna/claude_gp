# ── admin.gopasal.com (platform console) ──────────────────────────────────────
# Copy to `.env.local`. Everything here is NEXT_PUBLIC_*, i.e. it ships to the
# browser: put only publishable values in this file. Secrets — signing keys,
# provider credentials, database URLs — belong in apps/api/.env and never here.

# The GoPasal API's origin — no path, no trailing slash. The console appends
# /api/v1 itself, so a future API version is a code change, not a config change.
#
# Sign-in, the resolved permission list from GET /auth/me and the whole seller
# onboarding review queue are real API calls. With this unset those screens say
# the console is not connected rather than showing invented data.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this console, used for canonical links.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# ── Maps ──────────────────────────────────────────────────────────────────────
# Raster tile template for the coverage maps on the review queue and the shop
# record. When unset, the console shows an explicit offline grid rather than
# silently spending a public tile service's allowance. Whatever you point this
# at must permit the request volume of a staff console.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Shown on Settings → Integrations so an operator can see which provider the
# platform is configured against. The token is publishable by design; a secret
# key must never be placed in a NEXT_PUBLIC_* variable.
# NEXT_PUBLIC_MAP_PROVIDER=osm
# NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Optional. When set, the app-shell error boundary POSTs the digest of an
# unhandled render error here. Leave unset to keep failures in the browser
# console only.
# NEXT_PUBLIC_ERROR_SINK_URL=

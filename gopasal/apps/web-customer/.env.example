# ── gopasal.com (customer website) ────────────────────────────────────────────
# Copy to `.env.local` and replace every __REPLACE_ME__ with a real value.
# Everything here is NEXT_PUBLIC_*, i.e. it ships to the browser: put only
# publishable keys in this file. Secrets belong in apps/api/.env.

# GoPasal API. Leave EMPTY to run the site on built-in sample data — the live
# tracking map then animates a sample runner instead of a real one.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Map tiles for live delivery tracking.
#   osm    → tile.openstreetmap.org, needs no credential (default)
#   mapbox → needs NEXT_PUBLIC_MAPBOX_TOKEN below
#   none   → draws the built-in offline canvas, requests no tiles at all
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAPBOX_TOKEN=__REPLACE_ME__

# Public site URL, used for canonical links and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

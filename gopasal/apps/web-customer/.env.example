# ── gopasal.com (customer website) ────────────────────────────────────────────
# Copy to `.env.local` and replace every __REPLACE_ME__ with a real value.
# Everything here is NEXT_PUBLIC_*, i.e. it ships to the browser: put only
# publishable keys in this file. Secrets belong in apps/api/.env.

# GoPasal API. The customer site does not contain a simulated API fallback.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site URL, used for canonical links and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Match the API's MAP_PIN_PROVIDER when enabling the optional Google address
# picker. This enables the required Google-host CSP on the deployed web app;
# the actual browser key is still supplied by GET /discovery/map-config.
# MAP_PIN_PROVIDER=google

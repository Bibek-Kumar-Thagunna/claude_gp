{
  "name": "@gopasal/mobile-seller",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/hind": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@gopasal/native-data": "workspace:^",
    "@gopasal/native-ui": "workspace:^",
    "@gopasal/tokens": "workspace:^",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5",
    "@tanstack/react-query": "^5",
    "@tanstack/react-query-persist-client": "^5",
    "expo": "~57.0.23",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~19.0.7",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "APP_ENV=${APP_ENV:-local} expo start",
    "android": "APP_ENV=${APP_ENV:-local} expo start --android",
    "ios": "APP_ENV=${APP_ENV:-local} expo start --ios",
    "web": "APP_ENV=${APP_ENV:-local} expo start --web",
    "export:web": "APP_ENV=${APP_ENV:-local} expo export --platform web --output-dir dist-web",
    "prebuild": "APP_ENV=${APP_ENV:-local} expo prebuild --clean",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "APP_ENV=${APP_ENV:-test} tsx --test tests/*.test.ts",
    "lint": "echo \"(mobile-seller) lint via expo lint\" && exit 0",
    "clean": "rm -rf .expo dist-web node_modules"
  },
  "private": true,
  "description": "GoPasal seller app — the shop counter, on a phone."
}

# ═════════════════════════════════════════════════════════════════════════════
# GoPasal API — environment configuration
#
#   cp apps/api/.env.example apps/api/.env      # then run it; nothing else needed
#
# The values in this file are a WORKING LOCAL SETUP. A fresh clone runs the whole
# platform end to end — sign-in, onboarding, invitations, orders, delivery,
# tracking, uploads — with no external account, no API key and no credit card.
#
# HOW THAT WORKS, AND WHAT IT DOES NOT DO
# Every external service is reached through an interface, and a *_PROVIDER
# variable picks the implementation. The local implementations are real: the SMS
# provider prints the message it was asked to send, the map provider computes
# real great-circle distances, storage writes real files to disk. None of them
# reports success for something it did not do, and none of them weakens the
# business logic behind it — a one-time code in development is still random,
# still argon2-hashed, still expires, still rate-limited, and still has to be
# typed back into the same endpoint production uses.
#
# A provider is never silently downgraded. Ask for Sparrow without a token and
# the API refuses to start, naming the variable. That is deliberate: the failure
# mode this prevents is a deployment that believes it is sending SMS while the
# codes go to a log file.
#
# Each section below is marked:
#   DEVELOPMENT   what this file ships, working, credential-free
#   PRODUCTION    what to change, and which account you need to change it
# ═════════════════════════════════════════════════════════════════════════════

APP_ENV=local
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Express proxy trust controls which peer may supply X-Forwarded-For. Keep false
# when clients connect directly. In staging/production this must be explicit;
# use a hop count or comma-separated CIDRs matching the actual load balancers.
TRUST_PROXY=false

# Absolute base URL this API is reachable at. Public file URLs and links inside
# notifications are built from it, so it must be the address a *browser or phone*
# can reach — not "localhost" once anything else is involved.
#   DEVELOPMENT  omit; it defaults to http://localhost:$PORT
#   PRODUCTION   required, e.g. https://api.gopasal.com (boot fails without it)
# PUBLIC_URL=https://api.gopasal.com

# Customer storefront origin. Payment gateways return to the API for
# server-to-server verification, then the API redirects to this trusted origin.
# CUSTOMER_WEB_URL=https://gopasal.com

# Comma-separated list of allowed web origins (customer/seller/admin dev servers).
# CORS runs with credentials, so this is the list of browsers allowed to act as a
# signed-in user — not a convenience setting.
#   DEVELOPMENT  the three dev servers below
#   PRODUCTION   required. Unset defaults to http://localhost:3000, which no real
#                console can use, so boot fails instead of shipping an API the
#                browser silently refuses. "*" is rejected outright: a credentialed
#                response may not carry a wildcard origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Mount the Swagger UI and OpenAPI document at /$API_PREFIX/docs.
# The document lists every route, every request property and every validation rule,
# unauthenticated, so it follows the environment unless overridden:
#   DEVELOPMENT  on
#   PRODUCTION   off (set to true only for a deliberately public sandbox instance)
# API_DOCS_ENABLED=true

# Internal Prometheus listener. It runs on a separate port and is never mounted
# under the public API/Swagger server. Kubernetes permits this port only from
# the monitoring namespace. Local development leaves it off unless requested;
# staging and production require it.
# METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9464

# ── Database — PostgreSQL + PostGIS (docker compose up -d) ───────────────────
# HOST port 15432, not the default 5432: docker-compose.yml publishes the
# container's 5432 on host 127.0.0.1:15432, so GoPasal cannot collide with — or
# silently connect to — another PostgreSQL on this machine. 5433 is deliberately
# avoided too; it is the port a second native cluster is usually given.
# Check the ports are free, or move both sides at once, without editing files:
#   pnpm db:portcheck
#   pnpm db:setports <postgres-host-port> <redis-host-port>
DATABASE_URL=postgresql://gopasal:gopasal_dev_pw@localhost:15432/gopasal?schema=public

# ── Redis — cache, sessions, socket pub/sub, BullMQ (docker compose) ─────────
# HOST port 6380 -> container 6379, same reasoning as above (REDIS_HOST_PORT).
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ── Auth / JWT ──────────────────────────────────────────────────────────────
#   DEVELOPMENT  the two values below are fine and are what this file ships
#   PRODUCTION   generate both, and make them DIFFERENT from each other:
#                  openssl rand -hex 32
#                A production instance still carrying these development values
#                refuses to start — anyone holding this public file could
#                otherwise mint a valid session for any account.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=2592000     # seconds (30d)

# ── One-time codes (phone sign-in, onboarding, staff invitations) ────────────
# These rails are identical in development and production. The only thing that
# changes between them is the transport that carries the code (see SMS below).
OTP_TTL=300                 # seconds a code stays valid (5m)
OTP_LENGTH=6                # digits; 6 is the minimum worth having for SMS
OTP_MAX_ATTEMPTS=5          # wrong guesses before the challenge is burned
OTP_RESEND_COOLDOWN=60      # seconds a phone must wait between two requests
OTP_MAX_PER_HOUR=5          # hard ceiling per phone per hour (SMS costs money)

# ── SMS / OTP transport (interface: SmsProvider) ─────────────────────────────
# Options: log | sparrow | twilio        — every OTP flow uses this one provider:
# customer sign-in, seller sign-in, seller onboarding, and staff invitations.
#
#   DEVELOPMENT  SMS_PROVIDER=log
#                The code is printed to the API console in a boxed block:
#                  ┌─ SMS (development transport — NOT delivered) ──
#                  │ to:   +977 98XXXXXXXX
#                  │ text: Your GoPasal code is 123456 …
#                Read it there and type it into the app. Nothing is delivered to
#                a phone and the log says so on every line — there is no
#                universal code, no accepted-anything bypass, and no `devCode`
#                in the API response.
#
#   PRODUCTION   SMS_PROVIDER=sparrow (Nepal) or twilio
#                Boot fails, naming the missing variable, if its credentials are
#                absent. SMS_PROVIDER=log is REFUSED in production outright.
SMS_PROVIDER=log

# Optional, development only: also append every message to a JSONL file, which
# is handy for an automated end-to-end test that has to read the code back.
# Refused in production — it would write one-time codes to disk.
# SMS_DEV_OUTBOX_FILE=./tmp/sms-outbox.jsonl

# Sparrow SMS — sparrowsms.com. You need: an account, a credit balance, and a
# sender ID ("Identity") approved by the operators. Approval takes days, so
# request it well before launch.
# SPARROW_SMS_TOKEN=__REPLACE_ME__
# SPARROW_SMS_FROM=GoPasal
# SPARROW_SMS_URL=https://api.sparrowsms.com/v2/sms/

# Twilio — alternative / international fallback. Needs a project, a bought
# number, and Nepal enabled in Messaging Geographic Permissions.
# TWILIO_ACCOUNT_SID=__REPLACE_ME__
# TWILIO_AUTH_TOKEN=__REPLACE_ME__
# TWILIO_FROM=+10000000000

SMS_TIMEOUT_MS=10000        # a gateway that hangs must not hang sign-in

# ── Customer support assistant ──────────────────────────────────────────────
# Options: knowledge | openai
#
#   KEY-FREE     `knowledge` is a deterministic, source-cited production-safe
#                provider over release-reviewed GoPasal help articles. It works
#                without an account, key or card and escalates when evidence is weak.
#   MANAGED AI   `openai` uses the Responses API with strict structured output,
#                moderation, `store: false`, a bounded approved knowledge context
#                and no access to payments, refunds, accounts or admin tools.
#                Selecting it without a key makes the API refuse to start.
SUPPORT_ASSISTANT_PROVIDER=knowledge
# OPENAI_API_KEY=__REPLACE_ME__
OPENAI_SUPPORT_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
SUPPORT_ASSISTANT_TIMEOUT_MS=15000

# ── Maps / geocoding / routing (interface: MapProvider) ─────────────────────
# Options: osm | mapbox | baato
#
#   DEVELOPMENT  MAP_PROVIDER=osm — no key or map-vendor account. Server-side
#                geo methods make no vendor requests. Distances are real haversine calculations over real
#                coordinates; the result is flagged `degraded: true` so nothing
#                downstream mistakes it for a road-network route, and
#                reverse-geocoding returns null (no address) rather than a
#                fabricated street name. This is genuinely sufficient because
#                GoPasal promises no ETAs to anyone.
#
#   PRODUCTION   Baato is the recommended Nepal provider: live vector maps,
#                address autocomplete, place resolution, reverse geocoding and
#                bike routing. Use separate tokens so the server credential is
#                never sent to a browser. Restrict the browser token to the real
#                customer and seller origins in the Baato dashboard.
MAP_PROVIDER=osm
# BAATO_ACCESS_TOKEN=__REPLACE_ME__
# BAATO_BROWSER_ACCESS_TOKEN=__REPLACE_ME__
# BAATO_MAP_STYLE=breeze
# BAATO_API_BASE_URL=https://api.baato.io/api/v1
# BAATO_SERVER_MONTHLY_LIMIT=1200  # server calls only; Baato browser tiles also use credits
# Optional: Google address search + Google pin map only. Keep Baato as the
# server/tracking provider; set MAP_PIN_PROVIDER=google in the customer web env
# too for its production CSP. Google requires billing setup and strict quotas.
# MAP_PIN_PROVIDER=google
# MAP_PIN_BROWSER_TOKEN=__REPLACE_ME__
# MAP_STYLE_URL=https://maps.example.com/style.json
# MAPBOX_ACCESS_TOKEN=__REPLACE_ME__

# ── File / object storage (interface: StorageProvider) ──────────────────────
# Options: local | s3        (product images, KYC documents, delivery proof, CSVs)
#
#   DEVELOPMENT  STORAGE_PROVIDER=local — writes real bytes under apps/api/uploads
#                and serves the public ones back at /uploads/public/<key>. The
#                private/ subtree is never served statically; it is reached only
#                through an authorised API route. No credential of any kind.
#
#   ALSO LOCAL   STORAGE_PROVIDER=s3 against RustFS, which exercises the exact
#                production code path (SigV4-signed PUT/DELETE) on this machine:
#                  docker compose --profile s3 up -d
#                then uncomment the four local S3 lines below.
#
#   PRODUCTION   STORAGE_PROVIDER=s3 against Cloudflare R2, AWS S3 or
#                DigitalOcean Spaces. Boot fails without bucket and keys.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
# Override only if a CDN or reverse proxy serves /uploads from another host.
# STORAGE_LOCAL_PUBLIC_BASE_URL=

# RustFS (docker compose --profile s3 up -d) — credentials are the ones in
# docker-compose.yml and never leave this machine. The init job grants anonymous
# GET only to public/ and removes any earlier bucket-wide policy on every run.
# S3_ENDPOINT=http://localhost:19000
# S3_BUCKET=gopasal-dev
# S3_ACCESS_KEY=gopasal_dev
# S3_SECRET_KEY=gopasal_dev_secret

# Production storage. Path-style addressing is the default because RustFS and
# most S3 clones require it; set false for AWS proper (virtual-hosted style).
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://cdn.gopasal.com   # CDN in front of the bucket

# Every object lands under one of exactly two prefixes, and the difference is not
# cosmetic:
#
#   public/   product photos, shop fronts — fetchable without a credential, and
#             the only prefix a CDN or a bucket policy may expose.
#   private/  KYC documents (citizenship cards, bank proof). These have no URL at
#             all: the API reads them and streams them back through a route that
#             checks the caller, so the bucket must NOT be public-read. Grant
#             anonymous read to `public/*` only, or to nothing at all and put the
#             CDN in front with a signing rule.
#
# A bucket that is public-read at the root publishes every seller's citizenship
# card. Nothing in the application can protect against that, so it is checked in
# your bucket configuration, not here.

# Local disk in production is refused unless this is set on purpose. It survives a
# restart but not a redeploy onto new hardware, and KYC documents are exactly the
# thing you cannot re-collect — so the escape hatch exists for a single-VM
# deployment with a real backed-up volume, and for nothing else.
# STORAGE_LOCAL_ALLOW_IN_PRODUCTION=false

# ── Upload ceilings ─────────────────────────────────────────────────────────
# Bytes, enforced before a file is written and again by the multipart parser. The
# whole file is held in memory while it is validated (the type is sniffed from the
# magic bytes rather than trusted), so these numbers are also a concurrency
# budget: N simultaneous uploads can cost N × the ceiling in RSS.
#
# The defaults fit what sellers actually send from a phone: a photo of a shopfront
# and a multi-page registration PDF. Boot refuses a value of zero or below, and
# refuses anything above the multipart hard limit of 32 MiB, because a ceiling
# above that would let the parser truncate a file mid-request and the uploader
# would then be told the wrong thing ("unsupported type", from sniffing a cut-off
# buffer). Above 16 MiB you get a warning rather than a refusal.
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760

# ── Malware screening ───────────────────────────────────────────────────────
# Every accepted image/PDF is streamed to ClamAV before it enters storage.
# Staging/production refuse to boot with this disabled. A scanner outage makes
# readiness fail and each upload return 503; it never silently skips screening.
# For local screening: docker compose --profile scan up -d
# Then set MALWARE_SCAN_PROVIDER=clamav and CLAMAV_HOST=127.0.0.1 here.
# The container needs several GiB of RAM for signatures. No API key or card.
# ClamD TCP is unauthenticated; expose it only to the API on a private network.
MALWARE_SCAN_PROVIDER=disabled
# CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
CLAMAV_CONNECT_TIMEOUT_MS=2000
CLAMAV_SCAN_TIMEOUT_MS=30000

# ── Payments (interface: PaymentProvider) ───────────────────────────────────
# Cash on Delivery is fully implemented and needs no gateway, no account and no
# credential — which keeps checkout functional before gateway keys are supplied. It is
# also the method the platform is built around.
PAYMENTS_COD_ENABLED=true
#
# eSewa uses its signed ePay v2 POST form and server-side status check. Khalti
# uses KPG-2 server initiation and payment lookup. A configured Khalti provider
# also executes retry-safe full wallet refunds through Khalti's verified transaction
# refund API. eSewa, partial refunds and Khalti bank refunds that need a separately
# verified payer mobile stay in the audited finance queue for merchant-dashboard
# processing.
# Both payment methods remain absent from
# checkout until their required credentials exist; browser callbacks are never
# trusted as proof of payment.
#
# eSewa needs BOTH the merchant code and secret, or neither. Use vendor-issued
# sandbox credentials during integration, then live keys and live hosts at launch.
# ESEWA_MERCHANT_CODE=__REPLACE_ME__
# ESEWA_SECRET=__REPLACE_ME__
ESEWA_BASE_URL=https://rc-epay.esewa.com.np       # production: https://epay.esewa.com.np
# KHALTI_SECRET_KEY=__REPLACE_ME__
KHALTI_BASE_URL=https://dev.khalti.com            # production: https://khalti.com

# ── Device push (interface: PushProvider) ───────────────────────────────────
# Options: log
#
# In-app notifications are a database row and work everywhere, in development and
# in production; this variable only governs the extra nudge to a phone. There is
# one implementation because there is one honest implementation: device push
# needs a device-token registry, which arrives with the mobile apps. Until then
# there is nothing to send to, so PUSH_PROVIDER=fcm is refused rather than
# accepted-and-ignored.
PUSH_PROVIDER=log
# Only needed if the Expo project has enhanced security enabled.
# PUSH_PROVIDER=expo works without it for most projects.
EXPO_ACCESS_TOKEN=


# ── Email ───────────────────────────────────────────────────────────────────
# Not used by GoPasal. Accounts are phone-based; receipts, order updates and
# invitations go by in-app notification and SMS. There is no SMTP configuration
# to set because there is no code that sends mail — nothing is missing locally.

# ── Analytics / error monitoring ────────────────────────────────────────────
# No third-party SDK is installed. Nothing is exported off this machine, and
# there is no key to obtain before deploying. Observability is a deliberate
# later milestone; the API logs structurally in the meantime.

# ── Realtime GPS tuning (live rider tracking) ───────────────────────────────
# Fully local: rider positions travel over the app's own Socket.IO gateway and
# Redis. No external service is involved at any point.
RIDER_PING_MIN_INTERVAL_MS=3000   # server-side throttle on rider pushes
RIDER_LOCATION_STALE_MS=15000     # position considered STALE after this
RIDER_OFFLINE_MS=30000            # rider marked OFFLINE after this

{
  "name": "@gopasal/api",
  "version": "0.1.0",
  "private": true,
  "description": "GoPasal platform API — NestJS + Prisma + Postgres/PostGIS + Redis + Socket.IO.",
  "author": "Velayon Dynamics Pvt. Ltd.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prebuild": "prisma generate",
    "build": "nest build",
    "prelint": "prisma generate",
    "lint": "eslint \"src/**/*.ts\" \"prisma/*.ts\" --max-warnings 0",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "APP_ENV=${APP_ENV:-test} node --require ts-node/register/transpile-only --test $(find src -name '*.spec.ts' | sort)",
    "clean": "rm -rf dist .turbo node_modules",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:doctor": "bash ../../scripts/db-doctor.sh",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.5",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/platform-socket.io": "11.2.5",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/websockets": "11.2.5",
    "@prisma/client": "5.22.0",
    "@prometheus-io/client": "0.16.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "nanoid": "^3.3.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "8.57.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}

# ── rider.gopasal.com (rider console) ────────────────────────────────────────
# Copy to `.env.local` for local work. This value is embedded into browser
# assets at build time, so it is public and must be the API origin only.
# Production builds reject an unset value, localhost, HTTP, paths, wildcards,
# and reserved `.invalid` deployment placeholders.
NEXT_PUBLIC_API_URL=http://localhost:4000

# syntax=docker/dockerfile:1.7
FROM node:22.23.3-bookworm-slim AS build
ARG APP_ENV=production
ENV APP_ENV=$APP_ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@9.7.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/web-customer/package.json apps/web-customer/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/tokens/package.json packages/tokens/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web-customer apps/web-customer
COPY apps/next-security.ts apps/next-security.ts
COPY packages packages
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SELLER_URL
ARG MAP_PIN_PROVIDER=google
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SELLER_URL=$NEXT_PUBLIC_SELLER_URL \
    MAP_PIN_PROVIDER=$MAP_PIN_PROVIDER
RUN pnpm --filter @gopasal/web-customer build

FROM node:22.23.3-bookworm-slim AS runtime
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SELLER_URL
ARG MAP_PIN_PROVIDER=google
ENV APP_ENV=production NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SELLER_URL=$NEXT_PUBLIC_SELLER_URL \
    MAP_PIN_PROVIDER=$MAP_PIN_PROVIDER
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web-customer/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web-customer/.next/static ./apps/web-customer/.next/static
COPY --from=build --chown=node:node /app/apps/web-customer/public ./apps/web-customer/public
USER node
WORKDIR /app/apps/web-customer
EXPOSE 3000
CMD ["node", "server.js"]

# syntax=docker/dockerfile:1.7
FROM node:22.23.3-bookworm-slim AS build
ARG APP_ENV=production
ENV APP_ENV=$APP_ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@9.7.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/web-seller/package.json apps/web-seller/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/tokens/package.json packages/tokens/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web-seller apps/web-seller
COPY apps/next-security.ts apps/next-security.ts
COPY packages packages
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_IMAGE_HOSTS
ARG NEXT_PUBLIC_SELLER_PUBLIC_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_IMAGE_HOSTS=$NEXT_PUBLIC_IMAGE_HOSTS \
    NEXT_PUBLIC_SELLER_PUBLIC_URL=$NEXT_PUBLIC_SELLER_PUBLIC_URL
RUN pnpm --filter @gopasal/web-seller build

FROM node:22.23.3-bookworm-slim AS runtime
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_IMAGE_HOSTS
ARG NEXT_PUBLIC_SELLER_PUBLIC_URL
ENV APP_ENV=production NODE_ENV=production PORT=3001 HOSTNAME=0.0.0.0 \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_IMAGE_HOSTS=$NEXT_PUBLIC_IMAGE_HOSTS \
    NEXT_PUBLIC_SELLER_PUBLIC_URL=$NEXT_PUBLIC_SELLER_PUBLIC_URL
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web-seller/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web-seller/.next/static ./apps/web-seller/.next/static
COPY --from=build --chown=node:node /app/apps/web-seller/public ./apps/web-seller/public
USER node
WORKDIR /app/apps/web-seller
EXPOSE 3001
CMD ["node", "server.js"]
